# ============================================
# API SERVER - Environment Variables
# ============================================

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# JWT Secret (generate a strong random string for production)
JWT_SECRET=your-jwt-secret

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,https://firatech.systems,https://admin.firatech.systems

# AI Chat (at least one required for chat functionality)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Chat Configuration
CHAT_ENABLE_RULES=true

# ============================================
# GITHUB APP INTEGRATION
# ============================================
# GitHub App ID (from GitHub App settings page)
GITHUB_APP_ID=

# GitHub App Private Key (PEM format, keep newlines as \n in .env)
# Example: -----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
GITHUB_APP_PRIVATE_KEY=

# GitHub Installation ID (from the App's installation page)
# Found at: https://github.com/settings/installations/{id}
GITHUB_INSTALLATION_ID=

# GitHub Webhook Secret (set in App webhook settings)
GITHUB_WEBHOOK_SECRET=

# GitHub Organization name (the org the App is installed on)
GITHUB_ORG_NAME=

# GitHub API Version (optional, defaults to 2022-11-28)
GITHUB_API_VERSION=2022-11-28
